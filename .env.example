# Postgres local
DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/sales_engine

# Token da conta Apify (usado pelo actor memo23/cnpj-scraper)
APIFY_TOKEN=

# API key do Google Places (Text Search + Place Details habilitados)
GOOGLE_PLACES_API_KEY=

# API key da DeepSeek (etapa3_scoring e etapa4_email, modelo deepseek-chat)
DEEPSEEK_API_KEY=

# SMTP Zoho (etapa5_envio) — SMTP_PASSWORD é senha de app do Zoho, não a senha normal
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Data do primeiro envio real (YYYY-MM-DD) — controla a curva de warm-up em etapa5_envio/warmup.py
WARMUP_START_DATE=

# Etapa 7: chave (32 bytes hex) que criptografa a sessão do WhatsApp no banco. Gere com:
# python -c "import secrets; print(secrets.token_hex(32))"
WHATSAPP_AUTH_KEY=

# Etapa 7: WhatsApp do operador, para receber o aviso de aceite (DDI+DDD+numero, só dígitos. Ex.: 5511999998888)
WHATSAPP_NOTIFICACAO_OPERADOR=
